#!/usr/bin/env bash
# PostToolUse hook: re-assert the bequiet rule after anything that could have buried it.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/pyfind.sh"
SRC="${SCRIPT_DIR}/anchor.md"
OUT="${SCRIPT_DIR}/anchor-tool.json"

if [ "$SRC" -nt "$OUT" ] && PY="$(shut_py)"; then
    "$PY" "${SCRIPT_DIR}/build.py" >/dev/null 2>&1 || true
fi

[ -f "$OUT" ] || exit 0
cat "$OUT"
exit 0
