#!/usr/bin/env bash
# UserPromptSubmit hook: land the rule last, right before the reply is generated.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/pyfind.sh"
SRC="${SCRIPT_DIR}/anchor-prompt.md"
OUT="${SCRIPT_DIR}/anchor-prompt.json"

if [ "$SRC" -nt "$OUT" ] && PY="$(shut_py)"; then
    "$PY" "${SCRIPT_DIR}/build.py" >/dev/null 2>&1 || true
fi

[ -f "$OUT" ] || exit 0
cat "$OUT"
exit 0
